// C:\DataFlex Projects\FutbolWebApp\AppSrc\ZoomEntrenador.wo
// ZoomEntrenador
//

Use cWebView.pkg
Use cWebPanel.pkg
Use cWebMenuGroup.pkg
Use cWebMenuItem.pkg
Use cWebForm.pkg
Use cWebCombo.pkg
Use cWebHtmlBox.pkg
Use cWebGroup.pkg

Use cligaDataDictionary.dd
Use cequipoDataDictionary.dd
Use centrenadorDataDictionary.dd

Object oZoomEntrenador is a cWebView
    Set piColumnCount to 12
    Set psCSSClass to "Zoom ZoomEntrenador"
    Set psCaption to "Entrenador"
    Set peWebViewStyle to wvsDrilldown
    Set peViewType to vtZoom
    Set pbShowCaption to False
    Set Verify_Save_Msg to 0
    Set piMaxWidth to 1024

    Object oLiga_DD is a cligaDataDictionary
    End_Object 

    Object oEquipo_DD is a cequipoDataDictionary
        Set DDO_Server To oLiga_DD
    End_Object 

    Object oEntrenador_DD is a centrenadorDataDictionary
        Set DDO_Server To oEquipo_DD
    End_Object 

    Set Main_DD To oEntrenador_DD
    Set Server  To oEntrenador_DD

    // Declarado aquí para que el botón Despedir pueda usar RefProc antes de su definición
    Register_Procedure DespedirConfirmado Integer eRespuesta


    Object oWebMainPanel is a cWebPanel
        Set piColumnCount to 12
        WebSetResponsive piColumnCount rmMobile to 4

        Object oCabecera is a cWebHtmlBox
            Set piColumnSpan to 12
            Set psCSSClass to "ZoomCabecera"
            Set psHtml to "<div class='ZoomCabecera_Titulo'>Entrenador</div><div class='ZoomCabecera_Texto'>Ficha del entrenador y de su club</div>"
        End_Object

        Object oDatosGroup is a cWebGroup
            Set piColumnSpan to 12
            Set piColumnCount to 12
            Set psCaption to "Datos personales"
            Set psCSSClass to "ZoomBloque"
            WebSetResponsive piColumnCount rmMobile to 4

            Object oEntrenadorNombre is a cWebForm
                Entry_Item entrenador.Nombre
                Set piColumnSpan to 6
                Set piColumnIndex to 0
                Set peLabelPosition to lpTop
                Set psLabel to "Nombre"
            End_Object

            Object oEntrenadorApellido is a cWebForm
                Entry_Item entrenador.Apellido
                Set piColumnSpan to 6
                Set piColumnIndex to 6
                WebSetResponsive piColumnIndex rmMobile to 0
                Set peLabelPosition to lpTop
                Set psLabel to "Apellido"
            End_Object

            // Desplegable: las opciones salen de la validation table de la clase DD
            Object oEntrenadorNacionalidad is a cWebCombo
                Entry_Item entrenador.Nacionalidad
                Set piColumnSpan to 6
                Set piColumnIndex to 0
                Set peLabelPosition to lpTop
                Set psLabel to "Nacionalidad"
                Set psEmptyItemDescription to "Sin nacionalidad"
            End_Object
        End_Object

        Object oClubGroup is a cWebGroup
            Set piColumnSpan to 12
            Set piColumnCount to 12
            Set psCaption to "Club"
            Set psCSSClass to "ZoomBloque"
            WebSetResponsive piColumnCount rmMobile to 4

            Object oEquipoNombre is a cWebForm
                Entry_Item equipo.Nombre
                Set piColumnSpan to 6
                Set piColumnIndex to 0
                Set peLabelPosition to lpTop
                Set psLabel to "Equipo"
                Set psCSSClass to "CampoPadre"
                Set psPlaceHolder to "Sin equipo"
                Set pbPromptButton to True

                WebRegisterPath ntNavigateForward oSelectEquipo

                Procedure OnPrompt
                    Send NavigatePath
                End_Procedure
            End_Object

            Object oLigaNombre is a cWebForm
                Entry_Item liga.Nombre
                Set piColumnSpan to 6
                Set piColumnIndex to 6
                WebSetResponsive piColumnIndex rmMobile to 0
                Set peLabelPosition to lpTop
                Set psLabel to "Liga"
                Set psCSSClass to "CampoPadre"

                Procedure OnPrompt
                    Send NavigatePath
                End_Procedure
            End_Object

            // Solo en modo edición y con equipo (ver SetActionButtons)
            Object oDespedirBtn is a cWebButton
                Set psCaption to "Despedir"
                Set piColumnSpan to 4
                Set piColumnIndex to 0
                Set psCSSClass to "BotonNav"
                Set pbRender to False

                Procedure OnClick
                    // La respuesta va a la vista, que es donde está publicado DespedirConfirmado
                    Send ShowYesNo oZoomEntrenador (RefProc(DespedirConfirmado)) ;
                        (SFormat("¿Despedir a %1 %2? Se quedará sin equipo.", Trim(entrenador.Nombre), Trim(entrenador.Apellido))) ;
                        "Despedir entrenador"
                End_Procedure
            End_Object
        End_Object
    End_Object

    // Deja al entrenador sin equipo: se vacía el DDO del equipo y se guarda.
    // La clase DD admite el padre nulo y manda EquipoID como NULL.
    // Tras despedir, la vista no se cierra al guardar (ver OnViewSaved)
    Property Boolean pbDespidiendo False

    Procedure DespedirConfirmado Integer eRespuesta
        If (eRespuesta = cmYes) Begin
            Set pbDespidiendo to True
            Send Request_ClearBindingTable of oEquipoNombre
            Send Request_Save of oEntrenador_DD
            Set pbDespidiendo to False
            Send SetActionButtons
        End
    End_Procedure

    WebPublishProcedure DespedirConfirmado

    Object oActionGroup is a cWebMenuGroup

        Object oSaveBtn is a cWebMenuItem
            Set psCSSClass to "WebSaveMenuItem"
            Set psCaption to "Guardar"

            Procedure OnClick
                Send Request_Save
            End_Procedure

        End_Object 

        Object oEditBtn is a cWebMenuItem
            Set psCSSClass to "WebEditMenuItem"
            Set psCaption to "Editar"
            Procedure OnClick
                Send ChangeEditMode True
                Send SetActionButtons
            End_Procedure

        End_Object 

        Object oDeleteBtn is a cWebMenuItem
            Set psCSSClass to "WebDeleteMenuItem"
            Set psCaption to "Eliminar"
            Set peActionDisplay to adMenu

            Procedure OnClick
                Send Request_Delete
            End_Procedure

        End_Object 

        Object oCancelChangesBtn is a cWebMenuItem
            Set psCSSClass to "WebIcon_Refresh"
            Set psCaption to "Deshacer cambios"
            Set peActionDisplay to adMenu
            Procedure OnClick
                Send RefreshRecord
            End_Procedure

        End_Object 
    End_Object 

    Procedure SetActionButtons
        tWebNavigateData NavigateData
        Boolean bHasRecord
        Integer iEquipoID
        Handle hoDD

        Get Server to hoDD
        Get GetNavigateData to NavigateData
        Get HasRecord of hoDD to bHasRecord
        // Se mira la FK del propio entrenador y no el DDO del equipo
        Get Field_Current_Value of oEntrenador_DD Field entrenador.EquipoID to iEquipoID

        // Despedir: solo al editar un entrenador guardado que tenga equipo
        WebSet pbRender of oDespedirBtn to (not(NavigateData.bReadOnly) and bHasRecord and iEquipoID <> 0)

        // let's hide all buttons and then Show the ones we want
        WebSet pbRender of oEditBtn to False
        WebSet pbRender of oSaveBtn to False
        WebSet pbRender of oCancelChangesBtn to False
        WebSet pbRender of oDeleteBtn to False

        If (NavigateData.bReadOnly) Begin
            WebSet pbRender of oEditBtn to True
        End
        Else Begin
            WebSet pbRender of oSaveBtn to True
            WebSet pbRender of oCancelChangesBtn to True
            WebSet pbRender of oDeleteBtn to bHasRecord
        End
    End_Procedure

    Procedure OnViewSaved Handle hoServer Boolean bChanged
        // Close after save, salvo al despedir: se queda abierta con «Sin equipo»
        If (not(pbDespidiendo(Self))) Begin
            Send NavigateClose Self
        End
    End_Procedure

    // this will close the view after a delete
    Procedure OnViewDeleted Handle hoDDO
        Send NavigateClose Self
    End_Procedure

    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
        Case Begin
            Case (NavigateData.eNavigateType = nfFromMain)
                // If from main, this is a propbably a main file Select to Zoom.
                Case Break

            Case (NavigateData.eNavigateType = nfFromParent)
                // If from parent, this is a constrained drill down.
                Case Break

            Case (NavigateData.eNavigateType = nfFromChild)
                // If from child, this is a probably a parent Zoom from a Zoom.
                Case Break

            Case Else // must be nfUndefined

        Case End

        Send SetActionButtons

    End_Procedure

End_Object 
